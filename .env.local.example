# Microsoft Entra ID (Azure AD) Configuration
# Get these values from Azure Portal > Microsoft Entra ID > App registrations

# Application (client) ID
AZURE_AD_CLIENT_ID=your-client-id-here

# Client secret (create one in Certificates & secrets)
AZURE_AD_CLIENT_SECRET=your-client-secret-here

# Directory (tenant) ID
AZURE_AD_TENANT_ID=your-tenant-id-here

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-generate-with-openssl-rand-base64-32

# Group IDs for Role-Based Access Control
# Get these from Azure Portal > Microsoft Entra ID > Groups
ADMIN_GROUP_ID=your-admin-group-id
VIEW_GROUP_ID=your-view-group-id

# Session Configuration (in seconds)
# Access token expires in 1 hour by default
SESSION_MAX_AGE=3600
